default_platform(:ios)

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id:        ENV["APPSTORE_KEY_ID"],
      issuer_id:     ENV["APPSTORE_ISSUER_ID"],
      key_content:   ENV["APPSTORE_KEY_P8"],
      duration:      1200,
      in_house:      false
    )

    # Hent eller opprett distribusjonssertifikat og profil
    get_certificates(
      api_key:            api_key,
      output_path:        "/tmp/certs",
      generate_apple_certs: true
    )

    get_provisioning_profile(
      api_key:        api_key,
      app_identifier: "no.veierland.ferge",
      output_path:    "/tmp/profiles",
      provisioning_name: "Veierland Ferge AppStore"
    )

    # Skru på manuell signering med den nedlastede profilen
    update_code_signing_settings(
      use_automatic_signing: false,
      path:            "ios/App/App.xcodeproj",
      team_id:         ENV["APPLE_TEAM_ID"],
      bundle_identifier: "no.veierland.ferge",
      profile_name:    "Veierland Ferge AppStore",
      code_sign_identity: "iPhone Distribution"
    )

    build_number = ENV["GITHUB_RUN_NUMBER"] || "1"

    gym(
      project:        "ios/App/App.xcodeproj",
      scheme:         "App",
      configuration:  "Release",
      export_method:  "app-store",
      output_directory: "/tmp/build",
      xcargs:         "MARKETING_VERSION=1.0.0 CURRENT_PROJECT_VERSION=#{build_number}"
    )

    pilot(
      api_key:                          api_key,
      ipa:                              "/tmp/build/App.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
