# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for the map component to work.
GOOGLE_MAPS_PLATFORM_KEY="AIzaSy..."

# AISSTREAM_API_KEY: Optional. For tracking the ferry in real-time.
AISSTREAM_API_KEY=""

# BarentsWatch AIS (api/ferry.ts): live-posisjon for ferga på forsiden.
# Lag en gratis API-klient med tilgang til AIS på barentswatch.no. Settes i Vercel.
BARENTSWATCH_CLIENT_ID=""
BARENTSWATCH_CLIENT_SECRET=""
# Valgfri: MMSI for ferga (standard 257281900 = M/F Humla / GO Vakker Randi)
FERRY_MMSI=""
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
